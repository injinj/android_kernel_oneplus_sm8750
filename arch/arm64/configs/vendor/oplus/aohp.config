# AOHP: Linux IPC the Android GKI base config leaves out. The Debian/Fedora env runs ordinary Linux software
# (Steam's tier0, PostgreSQL, RMDS-style daemons, ipcs tooling) that expects SysV semaphores/shm/msg queues and
# POSIX message queues; without them those syscalls return ENOSYS.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_IPC_NS=y
